# 로컬 개발: npm run db:up -w @wakaaka/api 로 띄운 tmpfs Postgres
DATABASE_URL=postgres://wakaaka:wakaaka@127.0.0.1:54329/wakaaka_test
PORT=3000
HOST=127.0.0.1
# 빌드된 웹을 같이 서빙하려면(npm run build -w @wakaaka/web 뒤): 비워 두면 API만
WEB_DIST=
# 앱 속도 제한(DESIGN 9절). off면 끈다. 로컬 개발에서 저장을 많이 시험할 때
RATE_LIMIT=
# 1이면 CF-Connecting-IP를 IP로 믿는다. 터널로만 들어오는 서버(운영·테스트 compose)에서만
TRUST_CF_IP=
