{
  "about": "인라인 문법 파서 공통 테스트. 명세: docs/SPEC.md 2절. mode 기본값은 stored. expect는 ast(구문 트리 JSON), error(오류 코드), ok(파싱 성공만 확인) 중 하나.",
  "cases": [
    { "name": "plain", "text": "red hair, smile", "expect": { "ast": ["red hair, smile"] } },
    { "name": "empty-text", "text": "", "expect": { "ast": [] } },
    { "name": "choice", "text": "{a|b}", "expect": { "ast": [{ "choice": [["a"], ["b"]] }] } },
    { "name": "choice-empty-alt-last", "text": "{a|}", "expect": { "ast": [{ "choice": [["a"], []] }] } },
    { "name": "choice-empty-alt-first", "text": "{|a}", "expect": { "ast": [{ "choice": [[], ["a"]] }] } },
    { "name": "choice-empty", "text": "{}", "expect": { "ast": [{ "choice": [[]] }] } },
    { "name": "choice-two-empty", "text": "{|}", "expect": { "ast": [{ "choice": [[], []] }] } },
    { "name": "novelai-emphasis", "text": "{{masterpiece}}, best quality", "expect": { "ast": [{ "choice": [[{ "choice": [["masterpiece"]] }]] }, ", best quality"] } },
    { "name": "choice-nested", "text": "x {a|{b|c}} y", "expect": { "ast": ["x ", { "choice": [["a"], [{ "choice": [["b"], ["c"]] }]] }, " y"] } },
    { "name": "ref-wildcard", "text": "silver hair, ${w:hairColor001} streaks", "expect": { "ast": ["silver hair, ", { "ref": "w", "id": "hairColor001" }, " streaks"] } },
    { "name": "err-hash-prefix-reserved", "text": "${h:Snap00000001}", "expect": { "error": "E_REF_RESERVED" } },
    { "name": "err-hash-prefix-reserved-short", "text": "${h:x}", "expect": { "error": "E_REF_RESERVED" } },
    { "name": "err-hash-prefix-reserved-in-choice", "text": "{a|${h:Snap00000001}}", "expect": { "error": "E_REF_RESERVED" } },
    { "name": "err-hash-prefix-reserved-edit", "mode": "edit", "text": "${h:Snap00000001}", "expect": { "error": "E_REF_RESERVED" } },
    { "name": "ref-in-choice", "text": "{a|${w:hairColor001}}", "expect": { "ast": [{ "choice": [["a"], [{ "ref": "w", "id": "hairColor001" }]] }] } },
    { "name": "ref-adjacent", "text": "${w:hairColor001}${w:eyeColor0001}", "expect": { "ast": [{ "ref": "w", "id": "hairColor001" }, { "ref": "w", "id": "eyeColor0001" }] } },
    { "name": "pipe-outside-is-literal", "text": "a|b :|", "expect": { "ast": ["a|b :|"] } },
    { "name": "backslash-pipe-outside-is-literal", "text": "\\||/", "expect": { "ast": ["\\||/"] } },
    { "name": "double-backslash-then-pipe-outside", "text": "a\\\\|b", "expect": { "ast": ["a\\|b"] } },
    { "name": "escaped-pipe-inside-choice", "text": "{\\||/}", "expect": { "ast": [{ "choice": [["|"], ["/"]] }] } },
    { "name": "tag-with-pipes-inside-choice", "text": "{\\\\\\|\\|/}", "expect": { "ast": [{ "choice": [["\\||/"]] }] } },
    { "name": "comfy-backslashes-pass-through", "text": "\\(artist\\), \\m/, \\o/", "expect": { "ast": ["\\(artist\\), \\m/, \\o/"] } },
    { "name": "trailing-backslash", "text": "abc\\", "expect": { "ast": ["abc\\"] } },
    { "name": "double-backslash-before-brace", "text": "\\\\{a}", "expect": { "ast": ["\\", { "choice": [["a"]] }] } },
    { "name": "escaped-braces", "text": "\\{a\\}", "expect": { "ast": ["{a}"] } },
    { "name": "escapes-merge-into-one-literal", "text": "a\\{b\\}c\\\\d\\$e", "expect": { "ast": ["a{b}c\\d$e"] } },
    { "name": "dollar-literal", "text": "$ $5 $ {a}", "expect": { "ast": ["$ $5 $ ", { "choice": [["a"]] }] } },
    { "name": "dollar-at-end", "text": "price $", "expect": { "ast": ["price $"] } },
    { "name": "dollar-before-ref", "text": "$${w:hairColor001}", "expect": { "ast": ["$", { "ref": "w", "id": "hairColor001" }] } },
    { "name": "escaped-dollar-then-choice", "text": "\\${a}", "expect": { "ast": ["$", { "choice": [["a"]] }] } },
    { "name": "literal-ref-syntax", "text": "$\\{a\\}", "expect": { "ast": ["${a}"] } },
    { "name": "unicode", "text": "은발, {미소|웃음} 😀", "expect": { "ast": ["은발, ", { "choice": [["미소"], ["웃음"]] }, " 😀"] } },
    { "name": "escaped-close-inside-choice", "text": "{a\\}|b}", "expect": { "ast": [{ "choice": [["a}"], ["b"]] }] } },
    { "name": "nesting-64-ok", "text": "{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{a}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}", "expect": { "ok": true } },

    { "name": "edit-name-ref", "mode": "edit", "text": "${hair color}", "expect": { "ast": [{ "ref": "name", "name": "hair color" }] } },
    { "name": "edit-name-ref-trimmed", "mode": "edit", "text": "${  hair color\t}", "expect": { "ast": [{ "ref": "name", "name": "hair color" }] } },
    { "name": "edit-mixed-forms", "mode": "edit", "text": "${w:hairColor001} ${내 머리}", "expect": { "ast": [{ "ref": "w", "id": "hairColor001" }, " ", { "ref": "name", "name": "내 머리" }] } },
    { "name": "edit-reserved-param", "mode": "edit", "text": "${outfit color=red}", "expect": { "error": "E_REF_RESERVED" } },

    { "name": "err-unclosed-choice", "text": "{a", "expect": { "error": "E_UNCLOSED_CHOICE" } },
    { "name": "err-unclosed-choice-nested", "text": "{a|{b}", "expect": { "error": "E_UNCLOSED_CHOICE" } },
    { "name": "err-unmatched-close", "text": "a}", "expect": { "error": "E_UNMATCHED_CLOSE" } },
    { "name": "err-extra-close", "text": "{a}}", "expect": { "error": "E_UNMATCHED_CLOSE" } },
    { "name": "err-unclosed-ref", "text": "x ${w:hairColor001", "expect": { "error": "E_UNCLOSED_REF" } },
    { "name": "err-ref-empty", "text": "${}", "expect": { "error": "E_REF_EMPTY" } },
    { "name": "err-ref-blank", "text": "${ \t }", "expect": { "error": "E_REF_EMPTY" } },
    { "name": "err-ref-brace-in-body", "text": "${a{b}c}", "expect": { "error": "E_REF_INVALID" } },
    { "name": "err-ref-pipe-in-body", "text": "${a|b}", "expect": { "error": "E_REF_INVALID" } },
    { "name": "err-ref-backslash-in-body", "text": "${a\\|b}", "expect": { "error": "E_REF_INVALID" } },
    { "name": "err-ref-short-id", "text": "${w:short}", "expect": { "error": "E_REF_INVALID" } },
    { "name": "err-ref-long-id", "text": "${w:hairColor0012}", "expect": { "error": "E_REF_INVALID" } },
    { "name": "err-ref-non-ascii-id", "text": "${w:hairColor00한}", "expect": { "error": "E_REF_INVALID" } },
    { "name": "err-ref-padded-stored-form", "text": "${ w:hairColor001 }", "expect": { "error": "E_REF_INVALID" } },
    { "name": "err-ref-unknown-prefix", "text": "${x:hairColor001}", "expect": { "error": "E_REF_INVALID" } },
    { "name": "err-ref-uppercase-prefix", "text": "${H:Snap00000001}", "expect": { "error": "E_REF_INVALID" } },
    { "name": "err-name-ref-in-stored", "text": "${hair color}", "expect": { "error": "E_REF_NAME" } },
    { "name": "err-reserved-variable", "text": "${=x}", "expect": { "error": "E_REF_RESERVED" } },
    { "name": "err-reserved-param", "text": "${outfit color=red}", "expect": { "error": "E_REF_RESERVED" } },
    { "name": "err-nesting-65", "text": "{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{a}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}", "expect": { "error": "E_NESTING" } },
    { "name": "err-first-error-wins", "text": "a} {b", "expect": { "error": "E_UNMATCHED_CLOSE" } },
    { "name": "weight-choice", "text": "{3*silver|platinum}", "expect": {"ast": [{"choice": [["silver"],["platinum"]], "w": [3,1]}]} },
    { "name": "weight-explicit-one", "text": "{3*a|1*b}", "expect": {"ast": [{"choice": [["a"],["b"]], "w": [3,1]}]} },
    { "name": "weight-zero-alt", "text": "{0*a|b}", "expect": {"ast": [{"choice": [["a"],["b"]], "w": [0,1]}]} },
    { "name": "weight-leading-zeros", "text": "{007*a|b}", "expect": {"ast": [{"choice": [["a"],["b"]], "w": [7,1]}]} },
    { "name": "weight-max", "text": "{1000000*a|b}", "expect": {"ast": [{"choice": [["a"],["b"]], "w": [1000000,1]}]} },
    { "name": "weight-then-choice", "text": "{2*{a|b}|c}", "expect": {"ast": [{"choice": [[{"choice": [["a"],["b"]]}],["c"]], "w": [2,1]}]} },
    { "name": "weight-then-ref", "text": "{2*${w:abcdefghijkl}|c}", "expect": {"ast": [{"choice": [[{"ref": "w", "id": "abcdefghijkl"}],["c"]], "w": [2,1]}]} },
    { "name": "weight-empty-alt", "text": "{5*|a}", "expect": {"ast": [{"choice": [[],["a"]], "w": [5,1]}]} },
    { "name": "weight-read-once", "text": "{1*3*x}", "expect": {"ast": [{"choice": [["3*x"]], "w": [1]}]} },
    { "name": "weight-nested-both", "text": "{1*{2*a|b}|3*c}", "expect": {"ast": [{"choice": [[{"choice": [["a"],["b"]], "w": [2,1]}],["c"]], "w": [1,3]}]} },
    { "name": "weight-in-text", "text": "1girl, {3*red|blue} hair", "expect": {"ast": ["1girl, ",{"choice": [["red"],["blue"]], "w": [3,1]}, " hair"]} },
    { "name": "not-weight-leading-space", "text": "{ 3*a}", "expect": {"ast": [{"choice": [[" 3*a"]]}]} },
    { "name": "not-weight-star-only", "text": "{*a|b}", "expect": {"ast": [{"choice": [["*a"],["b"]]}]} },
    { "name": "not-weight-space-before-star", "text": "{3 *a}", "expect": {"ast": [{"choice": [["3 *a"]]}]} },
    { "name": "not-weight-digits-no-star", "text": "{2girls|solo}", "expect": {"ast": [{"choice": [["2girls"],["solo"]]}]} },
    { "name": "not-weight-outside-choice", "text": "3*a", "expect": {"ast": ["3*a"]} },
    { "name": "not-weight-mid-alt", "text": "{a 3*b|c}", "expect": {"ast": [{"choice": [["a 3*b"],["c"]]}]} },
    { "name": "not-weight-after-backslash", "text": "{\\3*a}", "expect": {"ast": [{"choice": [["\\3*a"]]}]} },
    { "name": "not-weight-after-escaped-bar", "text": "{a\\|2*b}", "expect": {"ast": [{"choice": [["a|2*b"]]}]} },
    { "name": "err-weight-decimal", "text": "{1.5*a|b}", "expect": {"error": "E_CHOICE_WEIGHT"} },
    { "name": "err-weight-dot", "text": "{.*a}", "expect": {"error": "E_CHOICE_WEIGHT"} },
    { "name": "err-weight-too-large", "text": "{1000001*a}", "expect": {"error": "E_CHOICE_WEIGHT"} },
    { "name": "err-weight-all-zero", "text": "{0*a|0*b}", "expect": {"error": "E_CHOICE_WEIGHT"} },
    { "name": "err-weight-all-zero-before-later-error", "text": "{0*a}}", "expect": {"error": "E_CHOICE_WEIGHT"} }
  ]
}
