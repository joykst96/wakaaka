{
  "name": "choice-weights-nested-ref",
  "about": "가중치 뒤의 참조와 선택지, 선택지 안의 가중치, 같은 문서 두 항목. 기대 출력은 참조 모델이 채웠다.",
  "covers": ["choice", "choice-weight", "ref-mine", "numbering"],
  "bundle": {
    "format": 1,
    "root": "root00000000",
    "lock": {"colorWildcar": "colorDoc0001"},
    "docs": {
      "root00000000": {
        "schema": 1,
        "select": {"count": [2, 2]},
        "items": [
          {"id": "a", "text": "{2*${w:colorWildcar}|1*{3*long|short} hair}"},
          {"id": "b", "text": "{9*smile|1*{frown|pout}}"}
        ]
      },
      "colorDoc0001": {"schema": 1, "items": [{"id": "x", "text": "red"}, {"id": "y", "text": "blue"}]}
    }
  },
  "runs": [
    {"seed": "0", "text": "red, smile"},
    {"seed": "1", "text": "smile, blue"},
    {"seed": "2", "text": "long hair, smile"},
    {"seed": "3", "text": "red, frown"},
    {"seed": "4", "text": "blue, smile"},
    {"seed": "5", "text": "smile, long hair"},
    {"seed": "6", "text": "smile, long hair"},
    {"seed": "7", "text": "smile, blue"},
    {"seed": "8", "text": "smile, short hair"},
    {"seed": "9", "text": "red, smile"},
    {"seed": "10", "text": "red, smile"},
    {"seed": "11", "text": "blue, smile"}
  ]
}
