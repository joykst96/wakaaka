{
  "name": "budget-depends-on-seed",
  "about": "maxExpansions 6. 'small'이 뽑히면 통과하고, 큰 쪽이 뽑히면 E_BUDGET. 전개 횟수만 seed에 따라 달라진다.",
  "covers": ["budget", "error", "limits"],
  "limits": {"maxExpansions": 6},
  "bundle": {
    "format": 1,
    "root": "root00000000",
    "lock": {"WbigFanOut00": "bigFanOut001", "WleafPool000": "leafPool0001"},
    "docs": {
      "root00000000": {"schema": 1, "items": [{"id": "i001", "text": "{small|${w:WbigFanOut00}}"}]},
      "bigFanOut001": {
        "schema": 1,
        "items": [
          {
            "id": "b001",
            "text": "${w:WleafPool000} ${w:WleafPool000} ${w:WleafPool000} ${w:WleafPool000} ${w:WleafPool000} ${w:WleafPool000}"
          }
        ]
      },
      "leafPool0001": {"schema": 1, "items": [{"id": "l001", "text": "leaf"}]}
    }
  },
  "runs": [
    {"seed": "0", "error": "E_BUDGET"},
    {"seed": "1", "text": "small"},
    {"seed": "2", "text": "small"},
    {"seed": "3", "text": "small"},
    {"seed": "4", "text": "small"},
    {"seed": "5", "error": "E_BUDGET"},
    {"seed": "6", "error": "E_BUDGET"},
    {"seed": "7", "error": "E_BUDGET"}
  ]
}
