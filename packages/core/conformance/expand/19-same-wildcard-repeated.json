{
  "name": "same-wildcard-repeated",
  "about": "같은 와일드카드를 한 텍스트에 두 번, ref 항목으로도 두 번. 경로가 달라 각자 뽑는다.",
  "covers": ["repeat", "ref-mine", "ref-item"],
  "bundle": {
    "format": 1,
    "root": "root00000000",
    "lock": {"WhairColor00": "hairColorV03"},
    "docs": {
      "root00000000": {
        "schema": 1,
        "select": {"count": [3, 3], "sep": " | "},
        "items": [
          {"id": "i001", "text": "${w:WhairColor00}, ${w:WhairColor00}"},
          {"id": "i002", "ref": {"wildcard": "WhairColor00"}},
          {"id": "i003", "ref": {"wildcard": "WhairColor00"}}
        ]
      },
      "hairColorV03": {
        "schema": 1,
        "name": "hair color",
        "items": [
          {"id": "c001", "text": "red"},
          {"id": "c002", "text": "blue", "w": 2},
          {"id": "c003", "text": "silver"}
        ]
      }
    }
  },
  "runs": [
    {"seed": "0", "text": "red | blue, silver | silver"},
    {"seed": "1", "text": "red | red, silver | red"},
    {"seed": "2", "text": "silver, silver | red | red"},
    {"seed": "3", "text": "red, red | blue | blue"},
    {"seed": "4", "text": "silver | blue, silver | blue"},
    {"seed": "5", "text": "blue, red | silver | red"},
    {"seed": "6", "text": "red, blue | red | red"},
    {"seed": "7", "text": "blue | blue, silver | silver"}
  ]
}
