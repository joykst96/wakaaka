{
  "name": "empty-pool",
  "about": "항목이 없는 문서와 count [0,0] 문서는 빈 문자열을 낸다(저장 때는 거부되지만 미리보기에서 만날 수 있다).",
  "covers": ["empty"],
  "bundle": {
    "format": 1,
    "root": "root00000000",
    "lock": {"WnoItems0000": "noItems00000", "WzeroCount00": "zeroCount000"},
    "docs": {
      "root00000000": {"schema": 1, "items": [{"id": "i001", "text": "[${w:WzeroCount00}|${w:WnoItems0000}]"}]},
      "zeroCount000": {"schema": 1, "select": {"count": [0, 0]}, "items": [{"id": "a001", "text": "x"}]},
      "noItems00000": {"schema": 1, "select": {"count": [1, 3]}, "items": []}
    }
  },
  "runs": [{"seed": "0", "text": "[|]"}, {"seed": "1", "text": "[|]"}]
}
