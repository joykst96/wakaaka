# deploy/*.sh가 읽는 개인 설정. local.env로 복사해 고친다(local.env는 저장소에 넣지 않는다).
# 이미 환경 변수로 정한 값이 우선한다(:= 는 비어 있을 때만 채운다).

# ssh 호스트(~/.ssh/config의 별칭). local이면 ssh 없이 이 PC Docker에서 리허설한다(Git Bash에서는 MSYS_NO_PATHCONV=1).
: "${WAKAAKA_TEST_SSH:=myserver}"
: "${WAKAAKA_PROD_SSH:=myserver}"

# test-tags.sh·prod-tags.sh가 서버로 보낼 태그 CSV(name,category,post_count,description)
: "${WAKAAKA_TAGS_CSV:=/path/to/danbooru-tags.csv}"
